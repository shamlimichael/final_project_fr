<!DOCTYPE html>
<html lang="en">
<head>
    <title>Trade-In Sign Up</title>
    <link rel="stylesheet" href="signup.css">
    <style>
    @import url('https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Stack+Sans+Notch:wght@200..700&display=swap');
    </style>    
</head>

<body>
    <div id="main_block">
        <h1 id="title">Trade-In</h1>
        
        <form action="/" method="POST">
            <input type="text" id="email" name="email" placeholder="email">
            <input type="text" id="username" name="username" placeholder="username">
            <input type="password" id="password" name="password" placeholder="password">

            <p id="error_log_in"></p> 

            <button id="sign_up">Sign up</button>
        </form>
    </div>
    <script src="signup.js"></script>
</body>
</html>