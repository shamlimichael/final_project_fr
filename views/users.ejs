<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Crypto Goats | Search</title>
    <link rel="stylesheet" href="main.css">
    <style>
    @import url('https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Stack+Sans+Notch:wght@200..700&display=swap');
    </style> 
</head>
<body>
    <header class="top_bar">
        <div class="top_left">
            <span class="logo">Crypto Goats</span>
        </div>
        <div class="top_right">
            <span class="nav_link">Your username: <%= account.username %> </span>
            <span class="balance_label">Balance: $<%= account.balance.toLocaleString() %></span>
            
        </div>
    </header>
    <main class="dashboard_main" style="margin-top: 80px;">
        <h2 class="section_title">Find Traders</h2>

        <form id="user_search_form" style="display: flex; gap: 10px; margin-bottom: 40px;">
            <input type="text" id="search_username" placeholder="username" class="search_input">
            <input type="number" id="search_min" placeholder="min net worth" class="search_input">
            <input type="number" id="search_max" placeholder="max net worth" class="search_input">
            <button type="submit" class="trade_btn">Search</button>
        </form>

        <div class="leaderboard_list" id="user_results"></div>
    </main>
    <script src="users.js"></script>
</body>
</html>