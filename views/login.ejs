<!DOCTYPE html>
<html lang="en">
<head>
    <title>Crypto Goats | Login</title>
    <link rel="stylesheet" href="login.css">
    <style>
    @import url('https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Stack+Sans+Notch:wght@200..700&display=swap');
    </style>    
</head>

<body>
    <div id="main_block">
        <h1 id="title">Crypto Goats</h1>
        <form id="log_in_form" action="/login" method="POST">
            <input type="text" id="username" name="username" placeholder="username / email">
            
            <div class="password-wrapper">
                <input type="password" id="password" name="password" placeholder="password">
                <img src="/resources/eye-white.png" alt="eye-open" id="eye-open" class="">
            </div>

           <p id="error_log_in"><% if (err) { %><%= err %><% } %></p>

            <button id = "log_in_button">Log in</button>
        </form>

            <button id = "sign_up">Sign up</button> 
    </div>
    <script src="login.js"></script>
</body>
</html>